{
  "esm": "1.3.0",
  "metadata": {
    "name": "mom6_ppm_limited_edge",
    "description": "One PPM_limit_pos-limited edge of a cell (MOM_continuity_PPM.F90:2663-2667): the raw edge scaled toward the cell mean, edge = h_0 + scale*(raw - h_0), where scale is the mom6_ppm_limit_scale of the cell (1 = the raw edge kept, 0 = the flat h_0 reconstruction, (0, 1) = partially limited). The single law replaces the four inline copies of the Fortran's h_L = h_in + scale*(h_L - h_in) / h_R = h_in + scale*(h_R - h_in) applications (F90:2665-2666); the caller binds raw to either the left or the right raw edge of the cell. Pure scalar algebra, [m].",
    "license": "MIT",
    "tags": ["esd:stencil", "family:mom6_cgrid", "grid:mom6_cgrid", "op:limit"],
    "references": [
      {
        "citation": "Colella, P., & Woodward, P. R. (1984). The Piecewise Parabolic Method (PPM) for gas-dynamical simulations. Journal of Computational Physics, 54(1), 174-201.",
        "doi": "10.1016/0021-9991(84)90143-8"
      }
    ]
  },
  "expression_templates": {
    "mom6_ppm_limited_edge": {
      "params": ["h_0", "scale", "raw"],
      "description": "One PPM_limit_pos-limited edge of a cell (MOM_continuity_PPM.F90:2663-2667)",
      "body": {
        "op": "+",
        "args": [
          "h_0",
          {
            "op": "*",
            "args": [
              "scale",
              { "op": "-", "args": ["raw", "h_0"] }
            ]
          }
        ]
      }
    }
  }
}
